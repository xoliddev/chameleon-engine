# ---------- required in production ----------
# 32+ random characters. Encrypts stored bot tokens / webhook URLs and derives webhook signing secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Database. Leave empty locally (uses file:data/chameleon.db).
# Production (free): Turso → app.turso.tech → Create database → copy URL + create a token.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Your Fiverr profile or gig link (used by every "Order on Fiverr" button). Read at build time.
NEXT_PUBLIC_FIVERR_URL=https://www.fiverr.com/

# Public site URL. Optional on Vercel (falls back to the production *.vercel.app domain).
# NEXT_PUBLIC_SITE_URL=https://chameleon-engine.vercel.app

# ---------- optional ----------
# Real Stripe charges in TEST mode only (must start with sk_test_).
# STRIPE_SECRET_KEY=sk_test_...

# Alerts for leads sent by anonymous visitors on the public demo
# (signed-in users connect their own Telegram / Slack / webhook in Dashboard → Settings).
# DEMO_TELEGRAM_BOT_TOKEN=123456789:AA...
# DEMO_TELEGRAM_CHAT_ID=123456789
# DEMO_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
